# ─── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Recommended: gpt-4o-mini (fast, cheap), gpt-4o (best quality)
OPENAI_MODEL=gpt-4o-mini

# ─── Database ─────────────────────────────────────────────────────────────────
# Default: data/search.db  (relative to project root)
DATABASE_URL=data/search.db

# ─── Search ───────────────────────────────────────────────────────────────────
MAX_SEARCH_RESULTS=30
MAX_LLM_SOURCES=8
MAX_QUERIES_PER_EXPANSION=4
RESULTS_PER_QUERY=10

# ─── Network ──────────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=15

# ─── Content ──────────────────────────────────────────────────────────────────
MAX_SOURCE_CHARS=12000

# ─── Cache ────────────────────────────────────────────────────────────────────
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# ─── Vector Search & Embeddings ───────────────────────────────────────────────
# Options: auto (default), local (on-device HuggingFace MiniLM), openai
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=seekai_docs
RRF_K=60
RRF_VECTOR_WEIGHT=0.5
RRF_FTS_WEIGHT=0.5

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ─── Academic & Research Providers ────────────────────────────────────────────
# Semantic Scholar — optional API key raises rate limit from 1 to 10 req/s
# Get yours at: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_RESULTS=10

# arXiv — fully public, no key required
ARXIV_MAX_RESULTS=10

# Crossref — polite-pool; set mailto to your address for higher priority
# See: https://api.crossref.org/swagger-ui/index.html
CROSSREF_MAILTO=seekai@example.com
CROSSREF_MAX_RESULTS=10

# ─── Authentication & Multi-Tenancy ───────────────────────────────────────────
AUTH_ENABLED=false
JWT_SECRET_KEY=seekai-secret-key-change-me-in-production-12345678
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ADMIN_API_KEY=seekai_admin_secret_key

# ─── Redis & Rate Limiting ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# ─── Real-Time News & RSS Crawler ─────────────────────────────────────────────
CRAWLER_ENABLED=true
CRAWLER_INTERVAL_SECONDS=300
CRAWLER_MAX_ARTICLES_PER_FEED=15
